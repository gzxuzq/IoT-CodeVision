{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "iot-showcase.vercel.app" }],
      "destination": "https://iot-showcase.hei-ai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "iot-showcase.vercel.app" }],
      "destination": "https://iot-showcase.hei-ai.com/:path*",
      "permanent": true
    }
  ]
}
