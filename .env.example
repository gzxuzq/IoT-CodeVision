# Local-only secrets for auto_update_iot.py.
# Copy this file to .env and fill in real values. Never commit .env.
# GitHub Actions reads AGNES_API_KEY from the repository secret of the same name.
# Optional non-secret overrides: Actions variables AGNES_BASE_URL and AGNES_MODEL.

AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://api.example.com/v1
AGNES_MODEL=your-model-name

# Accepted alias when AGNES_MODEL is unset:
AGNES_DEFAULT_MODEL=your-model-name
